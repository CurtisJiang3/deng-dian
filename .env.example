# Copy this file to .env and fill in the Feishu group bot webhook.
FEISHU_WEBHOOK_URL=
# If your bot requires a keyword, write that exact keyword here.
FEISHU_KEYWORD=Tibo
# Fill only if the bot has signature verification enabled.
FEISHU_SIGN_SECRET=
POLL_MINUTES=5
# Optional local path. Docker Compose sets DB_PATH=/data/tibo.sqlite3.
# DB_PATH=./data/tibo.sqlite3
# LOG_PATH=./data/tibo.log
